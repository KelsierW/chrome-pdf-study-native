{
  "name": "伴讀筆記（原生 PDF 版）",
  "description": "跟讀已開啟的 Chrome PDF 分頁。",
  "version": "1.0.1",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "開啟伴讀筆記（原生 PDF 版）"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' http://127.0.0.1:17372"
  }
}
